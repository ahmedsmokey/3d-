# ==============================================================================
# 3D PRINTER SPARE PARTS - DJANGO BACKEND SECURITY & CONFIGURATION
# ==============================================================================

# [IMPORTANT SECURITY NOTICE]:
# Never commit real passwords or production SECRET_KEY to git.
# Keep your actual .env file confidential and protected.

# ------------------------------------------------------------------------------
# 1) GENERAL & SECURITY KEYS
# ------------------------------------------------------------------------------
# Generate a strong 50+ character random key in production
SECRET_KEY=generate_a_random_unpredictable_secret_key_here_for_production
ENVIRONMENT=development
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ------------------------------------------------------------------------------
# 2) HTTPS, SSL & SECURITY HEADERS (Production)
# ------------------------------------------------------------------------------
# In production, set these to true to enforce HTTPS, HSTS, and encrypted cookies
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

# Allowed Frontend URLs for Cross-Origin Resource Sharing (CORS)
# Comma-separated list (e.g., https://yourdomain.com,https://admin.yourdomain.com)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 3) DATABASE SETTINGS & ENCRYPTION
# ------------------------------------------------------------------------------
# Development Default: SQLite
USE_POSTGRES=false

# Production / PostgreSQL Settings:
# DB_SSL_REQUIRE=true enforces encrypted transit (TLS/SSL mode = require)
DB_SSL_REQUIRE=false
DB_NAME=printpart_db
DB_USER=postgres
DB_PASSWORD=use_a_strong_and_complex_password_here
DB_HOST=localhost
DB_PORT=5432

# Option: Full Connection URI with SSL (e.g., Render, Railway, AWS RDS, Supabase)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
